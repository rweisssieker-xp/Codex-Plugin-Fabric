FABRIC_AUTH_MODE=device_code
FABRIC_TENANT_ID=common
FABRIC_CLIENT_ID=

# Optional service principal mode. Only use when your tenant and target Fabric API support it.
# FABRIC_AUTH_MODE=service_principal
# FABRIC_TENANT_ID=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=

# Optional local state and audit locations. Defaults stay under .fabric-plugin/.
# FABRIC_STATE_DIR=.fabric-plugin/state
# FABRIC_AUDIT_LOG=.fabric-plugin/audit/fabric-actions.jsonl
